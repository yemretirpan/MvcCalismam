@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ÇAKÜ Öğrenci Sistemi</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ========== SIDEBAR ========== -->
    <div class="sidebar">
        <a class="brand logo-only" asp-controller="Home" asp-action="Index">
            <img class="brand-logo"
                 src="@Url.Content("~/images/alogo.png")"
                 asp-append-version="true"
                 alt="ÇAKÜ Logo" style="height:auto; width:120px;" />
        </a>

        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
           asp-controller="Home" asp-action="Index">
            <i class="bi bi-house-door me-2"></i><span>Ana Sayfa</span>
        </a>

        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Ogrenciler" ? "active" : "")"
           asp-controller="Ogrenciler" asp-action="Index">
            <i class="bi bi-people me-2"></i><span>Öğrenciler</span>
        </a>

        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dersler" ? "active" : "")"
           asp-controller="Dersler" asp-action="Index">
            <i class="bi bi-book me-2"></i><span>Dersler</span>
        </a>

        <a class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Kayitlar" ? "active" : "")"
           asp-controller="Kayitlar" asp-action="Index">
            <i class="bi bi-journal-text me-2"></i><span>Kayıtlar</span>
        </a>

        <hr class="border-secondary" />

        <!-- Tema butonu -->
        <button id="themeToggle" type="button"
                class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center gap-2"
                title="Tema Değiştir">
            <i id="themeIcon" class="bi bi-moon"></i>
            <span>Tema Değiştir</span>
        </button>
    </div>
    <!-- ========== /SIDEBAR ========== -->
    <!-- ========== CONTENT ========== -->
    <main class="content">
        <div class="container my-4">
            @RenderSection("Breadcrumb", required: false)
            @RenderBody()
        </div>
    </main>
    <!-- ========== /CONTENT ========== -->
    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const root = document.documentElement;            // <html>
            const key = "theme";
            const stored = localStorage.getItem(key);

            // İlk yüklemede depolanan temayı uygula
            if (stored === "dark" || stored === "light") {
                root.setAttribute("data-bs-theme", stored);
            }

            const btn = document.getElementById("themeToggle");
            const icon = document.getElementById("themeIcon");

            const setIcon = () => {
                const isDark = root.getAttribute("data-bs-theme") === "dark";
                icon.classList.toggle("bi-moon", !isDark);
                icon.classList.toggle("bi-sun", isDark);
            };
            setIcon();

            if (btn) {
                btn.addEventListener("click", function () {
                    const current = root.getAttribute("data-bs-theme") || "light";
                    const next = current === "light" ? "dark" : "light";
                    root.setAttribute("data-bs-theme", next);
                    localStorage.setItem(key, next);
                    setIcon();
                });
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
