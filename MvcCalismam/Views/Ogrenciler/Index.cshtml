@model IEnumerable<MvcCalismam.Models.Ogrenci>

@{
    ViewData["Title"] = "Öğrenciler";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-1"></i>Ana Sayfa
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="bi bi-people me-1"></i>Öğrenciler
            </li>
        </ol>
    </nav>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="card-title mb-3">@ViewData["Title"]</h2>

        <!-- Filtre -->
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-5">
                <label class="form-label">Ad / Soyad / TC</label>
                <input type="text" name="search" value="@(ViewBag.Search ?? string.Empty)"
                       class="form-control" placeholder="Ara..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Yaş</label>
                <input type="number" name="yas" value="@(ViewBag.Yas ?? string.Empty)"
                       class="form-control" placeholder="Yaş" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-2"></i>Filtrele
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-2"></i>Temizle
                </a>
                <a asp-action="Create"
                   class="btn btn-success ms-auto d-inline-flex align-items-center gap-2">
                    <i class="bi bi-person-plus"></i><span>Yeni Öğrenci</span>
                </a>
            </div>
        </form>

        @if (TempData["ok"] is string ok)
        {
            <div class="alert alert-success mb-3">@ok</div>
        }

        <!-- Tablo -->
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>TC</th>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Yaş</th>
                    <th class="text-end" style="width:120px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>@o.Tc</td>
                        <td>@o.Ad</td>
                        <td>@o.Soyad</td>
                        <td>@o.Yasi</td>
                        <td class="text-end">
                            <form asp-action="Delete" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tc" value="@o.Tc" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="tooltip" title="Sil">
                                    <i class="bi bi-trash"></i><span class="visually-hidden">Sil</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
