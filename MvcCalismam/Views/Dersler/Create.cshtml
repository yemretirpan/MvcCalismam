@model MvcCalismam.Models.Ders
@{
    ViewData["Title"] = "Yeni Ders";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
            <li class="breadcrumb-item"><a asp-controller="Dersler" asp-action="Index">Dersler</a></li>
            <li class="breadcrumb-item active" aria-current="page">.Yeni Ders</li>
        </ol>
    </nav>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="card-title mb-3">Yeni Ders</h2>

        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()

            <div class="col-md-4">
                <label asp-for="Kod" class="form-label"></label>
                <input asp-for="Kod" class="form-control" />
                <span asp-validation-for="Kod" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Ad" class="form-label"></label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="Kredi" class="form-label"></label>
                <input asp-for="Kredi" type="number" class="form-control" />
                <span asp-validation-for="Kredi" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check2-circle me-2"></i>Kaydet
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Geri</a>
            </div>
        </form>
    </div>
</div>
