@model MvcCalismam.Models.Enrollment

@{
    ViewData["Title"] = "Kayıt Düzenle";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Kayitlar" asp-action="Index">Kayıtlar</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Düzenle
            </li>
        </ol>
    </nav>
}
<h2 class="mb-3">Not Güncelle</h2>

<div class="mb-3">
    <div><strong>Öğrenci:</strong> @Model.Student?.Ad @Model.Student?.Soyad</div>
    <div><strong>Ders:</strong> @Model.Course?.Kod - @Model.Course?.Ad</div>
</div>

<form asp-action="Edit" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="col-md-4">
        <label class="form-label">Not (opsiyonel)</label>
        <input name="notDegeri" class="form-control" type="number" step="0.01" value="@(Model.NotDegeri?.ToString("0.##") ?? "")" />
        <span asp-validation-for="NotDegeri" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-warning">Güncelle</button>
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
