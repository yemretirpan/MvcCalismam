@model IEnumerable<MvcCalismam.Models.Enrollment>

@{
    ViewData["Title"] = "Kayıtlar";
}

@section Breadcrumb {
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-1"></i>Ana Sayfa
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <i class="bi bi-journal-text me-1"></i>Kayıtlar
            </li>
        </ol>
    </nav>
}

<div class="card shadow-sm">
    <div class="card-body">

        <h2 class="card-title mb-3">Kayıtlar</h2>

        <!-- Filtre -->
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-4">
                <label class="form-label">Öğrenci</label>
                <select name="studentId" class="form-select" asp-items="ViewBag.Students">
                    <option value="">(Hepsi)</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Ders</label>
                <select name="courseId" class="form-select" asp-items="ViewBag.Courses">
                    <option value="">(Hepsi)</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-2"></i>Filtrele
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-2"></i>Temizle
                </a>
                <a asp-action="Create" class="btn btn-success ms-auto d-inline-flex align-items-center gap-2">
                    <i class="bi bi-journal-plus"></i><span>Yeni Kayıt</span>
                </a>
            </div>
        </form>

        @if (TempData["ok"] is string ok)
        {
            <div class="alert alert-success mb-3">@ok</div>
        }

        <!-- Tablo -->
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Öğrenci</th>
                    <th>Ders</th>
                    <th class="text-center">Not</th>
                    <th class="text-end" style="width:140px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var k in Model)
                {
                    <tr>
                        <td>@($"{k.Student.Ad} {k.Student.Soyad}")</td>
                        <td>@($"{k.Course.Kod} - {k.Course.Ad}")</td>
                        <td class="text-center">@k.NotDegeri</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@k.Id"
                               class="btn btn-warning btn-sm"
                               data-bs-toggle="tooltip" title="Not Güncelle">
                                <i class="bi bi-pencil-square"></i>
                                <span class="visually-hidden">Not Güncelle</span>
                            </a>

                            <form asp-action="Delete" asp-route-id="@k.Id" method="post" class="d-inline">
                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="tooltip" title="Sil">
                                    <i class="bi bi-trash"></i>
                                    <span class="visually-hidden">Sil</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
